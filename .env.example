# KARAMAY configuration. Copy to .env for local development (never commit .env).
# In staging/production set these in your platform's secret manager instead.
# Every value below is a placeholder.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Public origin that serves the web client (required in production, https only).
PUBLIC_ORIGIN=http://localhost:8080
# Extra origins allowed to call the API with credentials (comma-separated). Leave empty for same-origin only.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (load balancer = 1). Wrong values let clients spoof IPs.
TRUST_PROXY_HOPS=0

# --- PostgreSQL -------------------------------------------------------------
# Local values match docker-compose / db/local-init.sql. Use generated passwords anywhere else.
# Runtime role: DML only, NOT superuser, NOT BYPASSRLS (see docs/DEPLOYMENT.md).
DATABASE_URL=postgres://karamay_app:app_local_dev_only@localhost:5432/karamay
# Owner/migrator role, used only by `npm run migrate`.
DATABASE_MIGRATION_URL=postgres://karamay_owner:owner_local_dev_only@localhost:5432/karamay
# Runtime role name that receives grants during migration.
DATABASE_APP_ROLE=karamay_app
# verify-full (production default) | require | disable (local only)
DATABASE_SSL=disable
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...

# --- Redis (shared rate limits, quotas, budget, kill switch) -----------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=kmy:

# --- Secrets (generate fresh values per environment) ------------------------
# openssl rand -hex 32
IP_HASH_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# Journal/mood encryption keys: "<id>:<base64 32 bytes>". Generate: openssl rand -base64 32
# Keep old keys listed after rotation so existing rows still decrypt.
DATA_ENCRYPTION_KEYS=1:CHANGE_ME_base64_32_bytes
DATA_ENCRYPTION_ACTIVE_KEY_ID=1
# Admin API bearer token (>= 32 chars). Leave empty to disable admin endpoints. openssl rand -base64 48
ADMIN_API_TOKEN=

# --- Gemini (server-side only; never expose to the client) -----------------
AI_ENABLED=false
GEMINI_API_KEY=
# Verify the model id and prices on https://ai.google.dev/gemini-api/docs/models and /pricing before launch.
GEMINI_MODEL=
GEMINI_PRICE_INPUT_USD_PER_MTOK=
GEMINI_PRICE_OUTPUT_USD_PER_MTOK=
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=700
# GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_RESERVE_TOKENS=1024
AI_MAX_RETRIES=1
# Internal hard spending caps (USD, estimated from token usage). Required when AI is enabled.
AI_BUDGET_DAILY_USD=
AI_BUDGET_MONTHLY_USD=
AI_BUDGET_ALERT_THRESHOLDS=50,75,90
# HTTPS endpoint (e.g. a chat-ops webhook) that receives content-free ops alerts.
ALERT_WEBHOOK_URL=

# --- Accounts ---------------------------------------------------------------
ACCOUNTS_ENABLED=true
# none | dev-outbox (development only: verification/reset links are printed to the terminal).
# Accounts stay off until a mailer is configured.
MAILER=dev-outbox

# --- Payments ---------------------------------------------------------------
# none | test-hmac (tests only, refused in production). A real provider adapter is still to be written.
PAYMENTS_PROVIDER=none
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_WEBHOOK_TOLERANCE_SEC=300

# --- Community --------------------------------------------------------------
# Refused at startup until moderation safeguards exist (docs/COMMUNITY.md).
COMMUNITY_ENABLED=false

# --- Limits -----------------------------------------------------------------
# Optional JSON deep-merged over DEFAULT_LIMITS in src/config.ts, e.g.
# LIMITS_JSON={"ai":{"perDay":{"guest":10,"user":25,"premium":100}}}
LIMITS_JSON=
